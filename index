<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cardápio</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%;background:#ff8800;overflow:hidden;-webkit-tap-highlight-color:transparent}
.menu-host{position:fixed;inset:0;background:#ff8800}

.menu-palco-wrap{position:relative;width:100%;background:#ff8800;border-radius:18px;overflow:hidden;touch-action:none;-webkit-user-select:none;user-select:none}
.menu-palco{position:absolute;top:50%;left:50%;width:1400px;height:1920px;transform-origin:center center;background:#ff8800;overflow:hidden;cursor:pointer}

.menu-livro{position:absolute;top:50%;left:50%;width:1153.54px;height:1296.4px;margin:-648.2px 0 0 -576.77px;perspective:2800px;perspective-origin:50% 42%;transform:translate3d(0,0,0);transition:transform .95s cubic-bezier(.22,.68,.16,1)}
.menu-livro.inicio{transform:translate3d(-140px,0,0)}
.menu-livro.aberto{transform:translate3d(0,0,0)}
.menu-livro.fim{transform:translate3d(140px,0,0)}

.menu-capa{position:absolute;inset:0;z-index:1;border-radius:10px;background:linear-gradient(148deg,#343a42 0%,#191c20 36%,#2b3138 60%,#101215 100%);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08),0 36px 70px -18px rgba(90,35,0,.45),0 8px 24px rgba(0,0,0,.28);clip-path:inset(0 0 0 50%);transition:clip-path .95s cubic-bezier(.22,.68,.16,1)}
.menu-livro.aberto .menu-capa{clip-path:inset(0 0 0 0)}
.menu-livro.fim .menu-capa{clip-path:inset(0 50% 0 0)}
.menu-capa:after{content:"";position:absolute;inset:0;border-radius:10px;background:radial-gradient(120% 80% at 22% 8%,rgba(255,255,255,.10),rgba(255,255,255,0) 55%);pointer-events:none}

.menu-folha{position:absolute;top:22px;left:50%;width:554.77px;height:1252.4px;transform-origin:left center;transform-style:preserve-3d;transition:transform .95s cubic-bezier(.3,.06,.16,1);will-change:transform}
.menu-sem-transicao{transition:none}
.menu-face{position:absolute;inset:0;overflow:hidden;border-radius:4px;background:#f7f4ee;box-shadow:0 6px 22px -8px rgba(0,0,0,.45);backface-visibility:hidden;-webkit-backface-visibility:hidden}
.menu-verso{transform:rotateY(180deg)}
.menu-img{display:block;width:100%;height:100%;object-fit:cover;pointer-events:none}
.menu-vazio{width:100%;height:100%;background:linear-gradient(160deg,#fbf9f5,#ece7dd)}
.menu-frente:after,.menu-verso:after{content:"";position:absolute;inset:0;pointer-events:none}
.menu-frente:after{background:linear-gradient(90deg,rgba(0,0,0,.20),rgba(0,0,0,0) 18%)}
.menu-verso:after{background:linear-gradient(270deg,rgba(0,0,0,.20),rgba(0,0,0,0) 18%)}

.menu-brilho{position:absolute;inset:0;pointer-events:none;z-index:3;background:radial-gradient(circle at calc(var(--mx,50) * 1%) calc(var(--my,35) * 1%),rgba(255,255,255,.40),rgba(255,255,255,.07) 30%,rgba(255,255,255,0) 58%),linear-gradient(150deg,rgba(26,29,34,.34),rgba(26,29,34,.06) 48%,rgba(255,255,255,.05) 100%)}

.menu-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;padding:40px;text-align:center;background:linear-gradient(150deg,#31363d 0%,#191c20 46%,#0f1114 100%);color:#ece8df}
.menu-placeholder b{font-family:"Instrument Serif",ui-serif,Georgia,serif;font-size:64px;font-weight:400;line-height:1;letter-spacing:.01em}
.menu-placeholder i{display:block;width:72px;height:1px;background:rgba(236,232,223,.32)}
.menu-placeholder span{font-family:ui-sans-serif,system-ui,sans-serif;font-size:13px;letter-spacing:.34em;text-transform:uppercase;color:rgba(236,232,223,.55)}

.menu-espiral{position:absolute;top:22px;left:calc(50% - 27px);width:54px;height:1252.4px;z-index:200;pointer-events:none}
.menu-anel{position:absolute;left:0;width:54px;height:24px;margin-top:-12px;border-radius:50%;border:3.5px solid #b6bdc7;background:radial-gradient(ellipse at 50% 32%,rgba(255,255,255,.4),rgba(255,255,255,0) 62%);box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 2px 6px rgba(0,0,0,.4)}

</style>
</head>
<body>
<div class="menu-host">
  <div class="menu-palco" id="palco" style="transform:translate(-50%,-50%) scale(.3)">
    <div class="menu-livro inicio" id="livro">
      <div class="menu-capa"></div>
      <div class="menu-folha" data-folha="0" style="transform:rotateY(0deg);z-index:7"><div class="menu-face menu-frente"><img class="menu-img" src="data:image/jpeg;base64," alt=""><div class="menu-brilho"></div></div><div class="menu-face menu-verso"><img class="menu-img" src="data:image/jpeg;base64," alt=""></div></div><div class="menu-folha" data-folha="1" style="transform:rotateY(0deg);z-index:5"><div class="menu-face menu-frente"><img class="menu-img" src="data:image/jpeg;base64," alt=""></div><div class="menu-face menu-verso"><img class="menu-img" src="data:image/jpeg;base64," alt=""></div></div><div class="menu-folha" data-folha="2" style="transform:rotateY(0deg);z-index:3"><div class="menu-face menu-frente"><img class="menu-img" src="data:image/jpeg;base64," alt=""></div><div class="menu-face menu-verso"><img class="menu-img" src="data:image/jpeg;base64," alt=""></div></div>
      <div class="menu-espiral"><span class="menu-anel" style="top:1.3889%"></span><span class="menu-anel" style="top:4.1667%"></span><span class="menu-anel" style="top:6.9444%"></span><span class="menu-anel" style="top:9.7222%"></span><span class="menu-anel" style="top:12.5000%"></span><span class="menu-anel" style="top:15.2778%"></span><span class="menu-anel" style="top:18.0556%"></span><span class="menu-anel" style="top:20.8333%"></span><span class="menu-anel" style="top:23.6111%"></span><span class="menu-anel" style="top:26.3889%"></span><span class="menu-anel" style="top:29.1667%"></span><span class="menu-anel" style="top:31.9444%"></span><span class="menu-anel" style="top:34.7222%"></span><span class="menu-anel" style="top:37.5000%"></span><span class="menu-anel" style="top:40.2778%"></span><span class="menu-anel" style="top:43.0556%"></span><span class="menu-anel" style="top:45.8333%"></span><span class="menu-anel" style="top:48.6111%"></span><span class="menu-anel" style="top:51.3889%"></span><span class="menu-anel" style="top:54.1667%"></span><span class="menu-anel" style="top:56.9444%"></span><span class="menu-anel" style="top:59.7222%"></span><span class="menu-anel" style="top:62.5000%"></span><span class="menu-anel" style="top:65.2778%"></span><span class="menu-anel" style="top:68.0556%"></span><span class="menu-anel" style="top:70.8333%"></span><span class="menu-anel" style="top:73.6111%"></span><span class="menu-anel" style="top:76.3889%"></span><span class="menu-anel" style="top:79.1667%"></span><span class="menu-anel" style="top:81.9444%"></span><span class="menu-anel" style="top:84.7222%"></span><span class="menu-anel" style="top:87.5000%"></span><span class="menu-anel" style="top:90.2778%"></span><span class="menu-anel" style="top:93.0556%"></span><span class="menu-anel" style="top:95.8333%"></span><span class="menu-anel" style="top:98.6111%"></span></div>
    </div>
  </div>
</div>
<script>(function(){
  var palco=document.getElementById('palco');
  var livro=document.getElementById('livro');
  var FOLHAS=3;
  var atual=0,angulo=0,arrastando=false,iniX=null,moveu=false,raf=null,mx=50,my=32;

  function pintar(){
    for(var i=0;i<FOLHAS;i++){
      var el=document.querySelector('[data-folha="'+i+'"]');
      if(!el) continue;
      var virada=i<atual;
      var a=virada?-180:((arrastando&&i===atual)?angulo:0);
      el.style.transform='rotateY('+a+'deg)';
      el.style.zIndex=String(virada?(i+1)*2:(FOLHAS-i)*2+1);
      el.style.transition=(arrastando&&i===atual)?'none':'';
    }
    livro.className='menu-livro '+(atual===0?'inicio':(atual>=FOLHAS?'fim':'aberto'));
  }

  function medir(){
    var s=Math.min(window.innerWidth/1400,window.innerHeight/1920);
    palco.style.transform='translate(-50%,-50%) scale('+s+')';
  }
  window.addEventListener('resize',medir);
  medir();
  pintar();

  document.addEventListener('mousemove',function(e){
    var r=palco.getBoundingClientRect();
    mx=Math.round((e.clientX-r.left)/r.width*100);
    my=Math.round((e.clientY-r.top)/r.height*100);
    if(raf) return;
    raf=requestAnimationFrame(function(){
      raf=null;
      livro.style.setProperty('--mx',mx);
      livro.style.setProperty('--my',my);
    });
  });

  palco.addEventListener('pointerdown',function(e){
    if(atual>=FOLHAS) return;
    var r=palco.getBoundingClientRect();
    if(e.clientX<r.left+r.width/2) return;
    iniX=e.clientX; moveu=false; arrastando=true;
    if(palco.setPointerCapture) palco.setPointerCapture(e.pointerId);
  });

  window.addEventListener('pointermove',function(e){
    if(iniX===null) return;
    var r=palco.getBoundingClientRect();
    var pagina=554.77*(r.width/1400);
    var dx=iniX-e.clientX;
    if(Math.abs(dx)>6) moveu=true;
    angulo=-Math.max(0,Math.min(180,dx/pagina*180));
    pintar();
  });

  window.addEventListener('pointerup',function(){
    if(iniX===null) return;
    iniX=null;
    var ok=angulo<-90;
    arrastando=false;
    angulo=0;
    if(ok) atual=Math.min(FOLHAS,atual+1);
    pintar();
  });

  palco.addEventListener('click',function(e){
    if(moveu){ moveu=false; return; }
    var r=palco.getBoundingClientRect();
    if(e.clientX>r.left+r.width/2) atual=Math.min(FOLHAS,atual+1);
    else atual=Math.max(0,atual-1);
    pintar();
  });

  document.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight') atual=Math.min(FOLHAS,atual+1);
    else if(e.key==='ArrowLeft') atual=Math.max(0,atual-1);
    else return;
    pintar();
  });
})();</script>
</body>
</html>
